# LOGIPULSE Backend Environment Configuration
APP_NAME="LOGIPULSE Backend API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# Database Configuration (Default: SQLite file; switch to PostgreSQL when ready)
DATABASE_URL="sqlite:///./logipulse.db"

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Logging & Simulation
LOG_LEVEL="INFO" 
SIMULATION_SEED=42

# JWT Security & Token Lifecycle
# [CRITICAL]: Replace this in production with a cryptographically secure random key (>= 32 chars)!
JWT_SECRET_KEY="dev-insecure-jwt-secret-key-change-in-production-logipulse-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Rate Limiting Configuration (requests per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_REPORT_PER_MINUTE=15

# Database Connection Pool (PostgreSQL Production)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Observability & Metrics
METRICS_ENABLED=true

# Demo Seeding Password (Development Only)
DEMO_PASSWORD="LogiPulse#2026"

# Multi-Agent AI Configuration (Stage 10)
GEMINI_API_KEY=""
GROQ_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"
AI_PRIMARY_PROVIDER="gemini"
AI_FALLBACK_PROVIDER="groq"
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2


